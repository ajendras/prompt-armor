{
    "name": "prompt-armor/prompt-armor",
    "description": "Defends PHP apps against prompt injection with layered detection, sanitization and optional LLM auditing",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "prompt-injection",
        "llm",
        "ai-safety",
        "security",
        "owasp",
        "laravel"
    ],
    "authors": [
        {
            "name": "Prompt Armor Team"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "laravel/framework": "^10.0 || ^11.0",
        "orchestra/testbench": "^8.0 || ^9.0"
    },
    "autoload": {
        "psr-4": {
            "PromptArmor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PromptArmor\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "openai-php/client": "^4.0 for optional LLM SelfAuditor feature"
    },
    "extra": {
        "laravel": {
            "providers": [
                "PromptArmor\\Laravel\\PromptArmorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "policy": {
        "advisories": {
            "ignore-id": [
                "PKSA-b41t-wbzk-9q51",
                "PKSA-d5tc-s1qs-h781",
                "PKSA-3r5d-mb8f-1qw9",
                "PKSA-m5cs-t1y6-qpcs",
                "PKSA-mdq4-51ck-6kdq",
                "PKSA-8qx3-n5y5-vvnd",
                "PKSA-w7xr-vk7n-rstm",
                "PKSA-q46n-4fdk-zjr4",
                "PKSA-qzrn-rnz3-85w1"
            ]
        }
    }
}
